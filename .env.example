# Account Intelligence: environment template for LOCAL PROCESSES (uv run, make run, tests).
#
# Copy to .env (untracked) and fill in only what you need. Every comment describes the key
# directly BELOW it. Commented-out keys are optional or belong to another profile.
#
# The compose stack (make up) does NOT read this file for hosts: compose.yml sets service-name
# URLs (db, fake-idp, api, worker) itself, so the localhost values here never reach a container.
# Staging and production read from Cloud Run and Secret Manager; see docs/WIRING.md.
#
# Defaults are hermetic: no paid or external call happens until you set CONNECTORS=on and keys.
# A key left empty means "not configured". Never put a placeholder in a key: it is rejected.

# ---- process ---------------------------------------------------------------------------------
# Runtime profile: dev | test | staging | production (selects adapters and profile rules).
APP_ENV=dev
# Entry point this process serves: api | worker | job | migrate.
#SERVICE_ROLE=api
# Minimum level of the structured JSON logs.
#LOG_LEVEL=INFO
# HTTP port the API listens on (Cloud Run injects it).
#PORT=8080
# Directory of the versioned YAML config (only for images installed non-editably).
#CONFIG_DIR=

# ---- database ----------------------------------------------------------------------------------
# Runtime role app_rw (NOBYPASSRLS), asyncpg driver. Used by the API and the worker.
DATABASE_URL=postgresql+asyncpg://app_rw:local-dev-only@localhost:5432/ai
# Run checkpointer (LangGraph), psycopg driver: postgresql:// with NO +asyncpg. Role app_rw.
CHECKPOINT_DATABASE_URL=postgresql://app_rw:local-dev-only@localhost:5432/ai
# Runtime pool size and overflow per instance.
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=5
# Owner role for migrations and ops scripts ONLY (postgres superuser in dev). Never read by the
# API or worker; production uses a non-superuser owner role.
MIGRATOR_DATABASE_URL=postgresql://postgres:dev@localhost:5432/ai
# Password the migrations set on the app_rw role (migration step only).
APP_RW_PASSWORD=local-dev-only
# Cloud SQL IAM users that migration 0071 makes members of app_rw (migrate job; cloud only).
#APP_RW_IAM_USERS=
# Cloud SQL (staging and production only; IAM auth through the connector).
#CLOUD_SQL_INSTANCE=
#DB_IAM_USER=
#DB_NAME=

# ---- tenant sign-in tokens ---------------------------------------------------------------------
# JWKS of the client identity provider. Local: the fake IdP of `make up` on :9090.
JWKS_URL=http://localhost:9090/jwks
# Audience and issuer the tokens must carry (the fake IdP signs with these).
JWT_AUDIENCE=account-intelligence-local
JWT_ISSUER=http://fake-idp:9090/

# ---- staff (6th operator) sign-in: all of issuer, audience and JWKS, or none -------------------
# Google Workspace issuer.
#STAFF_JWT_ISSUER=https://accounts.google.com
# Your Google OAuth client id (audience). Unset means the operator console stays disconnected.
#STAFF_JWT_AUDIENCE=
# Google signing keys.
#STAFF_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Workspace domain staff accounts must belong to (checked on the hd claim and the email domain).
#STAFF_WORKSPACE_DOMAIN=
# Comma-separated allowlists. Operators can change settings; support can read with a grant.
#STAFF_OPERATOR_EMAILS=
#STAFF_SUPPORT_EMAILS=
# Web app (Next.js server only): OAuth redirect URI registered on the Google client.
#OPERATOR_GOOGLE_REDIRECT_URI=http://localhost:3000/api/operator/callback

# ---- run limits (slice length, slice count and tenant concurrency live in config/<env>.yaml) ----
# Per-run spend ceiling in USD, all phases.
RUN_BUDGET_USD=5.0
# Per-run provider call ceiling.
#RUN_TOOL_CALL_CAP=60
# Credits reserved from the wallet when a run starts.
#RUN_RESERVE_CREDITS=6.0

# ---- web app (Next.js server only, never NEXT_PUBLIC_) -----------------------------------------
# Backend origin the Next.js server proxies /v1/* to (compose sets http://api:8080).
API_ORIGIN=http://localhost:8080
# Object storage origin the browser sends file chunks to (CSP connect-src): the dev object store
# http://localhost:8092, or https://storage.googleapis.com in the cloud. Unset: same origin only.
#UPLOAD_ORIGIN=http://localhost:8092

# ---- payload store ------------------------------------------------------------------------------
# Local directory for raw payloads and exports (dev). Unset: in-memory (lost on restart).
# Staging and production use PAYLOAD_BUCKET (GCS) instead; there is no S3 or MinIO adapter.
#PAYLOAD_DIR=/tmp/payloads
#PAYLOAD_BUCKET=
# Dev only: the browser-facing URL of the development object store (resumable uploads straight to
# storage, never through the web app or the API). Unset: the API's content route stands in.
#DEVSTORE_PUBLIC_URL=http://localhost:8092
# Dev only (objectstore service): the directory it writes (the blob root, PAYLOAD_DIR/files).
#DEVSTORE_ROOT=/tmp/payloads/files
# Dev only (objectstore service): comma-separated web origins it answers.
#DEVSTORE_ALLOW_ORIGIN=http://localhost:3010,http://localhost:3000
# Dev only (objectstore service): how long an upload session lives, in seconds.
#DEVSTORE_SESSION_TTL_S=172800

# ---- providers (broker adapters). Off by default; a provider is configured only when every one
# ---- of its keys is set. With CONNECTORS=off no provider is ever called.
# Live provider connectors in dev: off | on.
CONNECTORS=off
# Web search: Parallel.
P_SEARCH_API_KEY=
# Page scrape: Firecrawl.
P_SCRAPE_API_KEY=
# Company signals: PredictLeads (needs this key AND the token below).
P_SIGNALS_API_KEY=
# Company signals: PredictLeads token (paired with the key above).
P_SIGNALS_API_TOKEN=
# People data: Bitscale.
P_PEOPLE_API_KEY=
# Organisation data: Sumble.
P_ORG_API_KEY=

# ---- model (LLM) --------------------------------------------------------------------------------
# Model API key for local runs only. Empty: model features answer "not configured" (fail
# closed). Staging and production read Secret Manager entry ANTHROPIC_SECRET instead.
ANTHROPIC_API_KEY=
# Live tabular evaluation defaults (Cloud Run images provide the same defaults).
EVAL_MODEL=kimi-k3
EVAL_EFFORT=high
# Kimi K3 by Moonshot AI (owner decision 2026-10-14): a user choice for research or analysis,
# shown "Not set up" until this is set; cloud: MOONSHOT_SECRET names the Secret Manager secret
MOONSHOT_API_KEY=
# Grok 4.5 by xAI (owner decision 2026-10-20): a user choice for research or analysis, shown
# "Not set up" until this is set; cloud: XAI_SECRET names the Secret Manager secret
XAI_API_KEY=
# How the model provider is reached: anthropic_api | vertex_ai.
#LLM_ACCESS=anthropic_api
# Vertex AI region when LLM_ACCESS=vertex_ai.
#VERTEX_REGION=
# Secret Manager secret id holding the model key (staging and production).
#ANTHROPIC_SECRET=anthropic-api-key
# Secret Manager secret id of the Kimi K3 key (cloud); unset: Kimi K3 is "Not set up".
#MOONSHOT_SECRET=
# Kimi K3 API base URL (default https://api.moonshot.ai/v1).
#MOONSHOT_BASE_URL=
# Which API serves Kimi K3: moonshot (default), or ollama for Ollama Cloud (owner decision
# 2026-10-15; then MOONSHOT_BASE_URL=https://ollama.com/v1 and MOONSHOT_MODEL=kimi-k3:cloud).
#MOONSHOT_API_DIALECT=moonshot
# The provider's own Kimi K3 model name when it differs (Ollama Cloud: kimi-k3:cloud).
#MOONSHOT_MODEL=
# A file holding the Kimi K3 key (local runs, instead of MOONSHOT_API_KEY).
#MOONSHOT_API_KEY_FILE=
# Secret Manager secret id of the Grok 4.5 key (cloud); unset: Grok 4.5 is "Not set up".
#XAI_SECRET=
# Grok 4.5 API base URL (default https://api.x.ai/v1).
#XAI_BASE_URL=
# A file holding the Grok 4.5 key (local runs, instead of XAI_API_KEY).
#XAI_API_KEY_FILE=
# Recorded model router switch (legacy): off | on.
#MODEL_ROUTER=off
# Set by Cloud Run itself (never set them by hand): a dev or test profile refuses to start with either.
#K_SERVICE=
#CLOUD_RUN_JOB=
# Secret Manager secret id of the CSRF signing key (api; staging and production).
#CSRF_KEY_SECRET=csrf-signing-key
# Cloud KMS key for optional encrypted tenant model keys.
#BYOK_KMS_KEY=
# Hermetic fake model (dev and test only; refused in staging and production).
#LLM_FAKE=hermetic
# Fake model scenario under config/hermetic/fake_model.
#FAKE_MODEL_SCENARIO=happy

# ---- Google Cloud runtime (staging and production) ---------------------------------------------
#GCP_PROJECT=
#GCP_REGION=
#TASKS_QUEUE=
# Worker only: read-only mount of the payload bucket (the sandbox reads documents in place).
#BLOB_MOUNT_DIR=
# Document processing and research-job queues (unset: TASKS_QUEUE).
#TASKS_QUEUE_DOCUMENTS=
#TASKS_QUEUE_JOBS=
# HTTPS URL of the worker (dev compose posts slices to http://worker:8081).
#WORKER_URL=
#TASKS_SERVICE_ACCOUNT=
#TASKS_AUDIENCE=
# The one Redis setting (redis:// locally, rediss:// for Memorystore with TLS): shared sign-in and
# provider rate limits, and the research cache index (finished provider calls and model replies
# reused across runs of one tenant). Unset: in-process rate buckets, Postgres-only cache lookups.
#REDIS_URL=redis://redis:6379/0
# Reuse finished provider calls and model replies across runs (on, default) or pay anew (off).
#RESEARCH_CACHE=on
# Ask: the uploaded file a question is about goes to the model whole up to this many characters;
# a larger file answers through retrieved passages only.
#ASK_WHOLE_FILE_MAX_CHARS=300000
# Ask: when no routing rule decides whether a question is tabular or prose, ask the
# conversation's model (one short call at temperature 0); off offers tools and retrieval both.
#ASK_ROUTE_LLM_FALLBACK=on
# Malware scan of uploaded documents: signature (local only) or clamd. Cloud: clamd or every
# upload is rejected unscanned.
#DOCUMENT_SCANNER=signature
#CLAMD_HOST=
#CLAMD_PORT=3310
# Speech to text for uploaded audio: off (no vendor chosen; audio uploads are rejected).
#AUDIO_TRANSCRIPTION=off
# Worker: end runs whose worker died PARTIAL worker_lost (on, default) or never (off).
#RUN_SWEEPER=on
# Seconds a run lease must be expired before the sweeper ends the run.
#ORPHAN_AFTER_S=600
# Seconds between orphan sweeps in the worker.
#SWEEP_INTERVAL_S=300
# Local stack only: treat every provider balance as funded (unattended runs).
#DEV_ASSUME_PROVIDER_BALANCE=
# Local stack only: approve run caps as tenant policy without a person.
#DEV_AUTO_APPROVE_CAPS=
# Web build: Next.js output directory override (parity builds).
#NEXT_DIST_DIR=
# Web tests: origin of the web app the parity suite drives.
#PARITY_WEB_ORIGIN=
# Web tests: comma separated screen ids the screenshot suite captures.
#SCREENS=
# Public HTTPS origin of the web app (OIDC redirects, links).
#PUBLIC_BASE_URL=
# Accept unsigned task calls from the local scheduler (local stack only).
#ALLOW_UNAUTHENTICATED_TASKS=0

# ---- mail and drive ------------------------------------------------------------------------------
# Per-user read-only Gmail, Outlook, Google Drive, OneDrive and SharePoint. Each provider needs an
# OAuth app the owner registers (redirect URI: <PUBLIC_BASE_URL>/v1/mail-and-drive/callback).
# Without both values a provider's sources say "Not available yet". Never commit a value.
#MAILDRIVE_GOOGLE_CLIENT_ID=
# Mail and drive API base URLs (defaults: the public Google and Microsoft endpoints).
#GMAIL_API_BASE=
#GOOGLE_DRIVE_API_BASE=
#MICROSOFT_GRAPH_API_BASE=
#MAILDRIVE_GOOGLE_CLIENT_SECRET=
#MAILDRIVE_GOOGLE_CLIENT_SECRET_FILE=
#MAILDRIVE_MICROSOFT_CLIENT_ID=
#MAILDRIVE_MICROSOFT_CLIENT_SECRET=
#MAILDRIVE_MICROSOFT_CLIENT_SECRET_FILE=

# ---- research jobs -------------------------------------------------------------------------------
# Research job engine: graph (runs on the lifecycle and the ABM agent graph; cloud default) |
# hermetic (no outside call; dev and test default) | skill (refused until the executor is built).
#RESEARCH_ENGINE=

# ---- exports ------------------------------------------------------------------------------------
# Word renderer: python-interim (default everywhere) | node (once the Node library is ported).
#EXPORT_RENDERER=
# LibreOffice render checks on every export: off | on.
#EXPORT_RENDER_CHECKS=off

# ---- email (owner decision 2026-10-15): unset SMTP_HOST keeps mail fail closed ----------------
# SMTP server, e.g. smtp.gmail.com; 587 STARTTLS or 465 implicit TLS; the password is a secret.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#MAIL_FROM=
#MAIL_FROM_NAME=
# Staff members on external domains (comma separated emails) who are operators.
#STAFF_EXTERNAL_EMAILS=
# ---- document retrieval and metrics ------------------------------------------------------------
# fastembed indexes and searches documents by meaning with an on-server model (no per-use cost).
#DOCUMENT_SEMANTIC_EMBEDDER=fastembed
# Directory holding the baked-in embedding model files (no run-time download).
#FASTEMBED_CACHE_PATH=
# cloud_monitoring sends app metrics to Cloud Monitoring (workload.googleapis.com/*).
#METRICS_EXPORT=
