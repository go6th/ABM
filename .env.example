# ======================== app/ (roadmap Phase 0 onwards) ========================
# The app reads ENVIRONMENT VARIABLES ONLY (app/settings.py); it never reads a .env file.
# Export these in your shell or let docker compose / the secrets manager inject them.
ENV=dev
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=account-intelligence
# Postgres 16 from docker compose (`make up`). Runtime role, non-owner.
DATABASE_URL=postgresql://app_rw:app_rw_dev@localhost:5432/ai
# S3-compatible object storage (MinIO from docker compose locally). Raw broker JSON is
# stored under neutral keys only. The access and secret keys below are local dev values;
# real environments inject them from the secrets manager.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=account-intelligence-dev
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin-dev
OBJECT_STORE_REGION=us-east-1
# Database tests (tests/app/db) need one of these, otherwise they are skipped:
#   TEST_DATABASE_URL  admin URL to a running Postgres 16; a throwaway database is made per test
#   PG_BIN             directory with initdb and pg_ctl; a throwaway cluster is started
# TEST_DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
# PG_BIN=/usr/lib/postgresql/16/bin
# Offline by default: fake model provider and recorded broker responses. No credits spent.
MODEL_MODE=fake
BROKER_MODE=recorded
# Live keys (Phase 1 onwards). Leave unset for Phase 0. Never commit values.
# ANTHROPIC_API_KEY=
# PARALLEL_API_KEY=
# FIRECRAWL_API_KEY=
# PREDICTLEADS_API_KEY=
# PREDICTLEADS_API_TOKEN=
# BITSCALE_API_KEY=
# SUMBLE_API_KEY=
# Real deploys only (scripts/deploy.sh):
# IMAGE_REGISTRY=
# DEPLOY_CREDENTIALS_REF=

# ======================== legacy src/abm_generator (earlier roadmap) ========================
# Copy to .env and fill in. Never commit .env.
# ---- Database ----
# Runtime (app_rw, non-owner, NOBYPASSRLS): uses DATABASE_URL from the app section above.
# Owner / migrator (DDL only, never used at runtime).
MIGRATOR_DATABASE_URL=postgresql://postgres:dev@localhost:5432/ai
# Dedicated per-run connection string for the checkpoint runner (T11).
CHECKPOINT_DATABASE_URL=postgresql://app_rw:app_rw_dev@localhost:5432/ai

# ---- Isolation tests ----
# Owner DSN used by test fixtures to create tenant fixtures (migrator work, not runtime).
TEST_MIGRATOR_DSN=postgresql://postgres:dev@localhost:5432/ai
# Session-level tenant DSNs used by the checkpoint-prefix test.
TEST_TENANT_A_DSN=postgresql://app_rw:app_rw_dev@localhost:5432/ai
TEST_TENANT_B_DSN=postgresql://app_rw:app_rw_dev@localhost:5432/ai

# ---- Spike 3 (prompt cache) ----
SPIKE3_PROVIDER=dry_run
# SPIKE3_API_KEY=  # set in .env only, never commit

# ---- Spike 4 (broker economics) ----
SPIKE4_PROVIDER=dry_run
# SPIKE4_BROKER_KEYS=  # set in .env only, never commit
