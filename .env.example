# =============================================================================
# Account Intelligence & ABM Platform - Environment Configuration Example
# Copy this file to .env and provide your environment-specific values.
# NEVER commit production secrets, keys, or passwords to git.
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://app_rw:your-app-password@localhost:5432/ai
MIGRATOR_DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/ai
CHECKPOINT_DATABASE_URL=postgresql+asyncpg://app_rw:your-app-password@localhost:5432/ai
APP_RW_PASSWORD=your-app-password

# Identity & JWT Verification (OIDC / OAuth / SSO)
JWKS_URL=http://localhost:9090/.well-known/jwks.json
JWT_AUDIENCE=account-intelligence-local
JWT_ISSUER=http://localhost:9090

# Staff & Operator Console Access
STAFF_JWT_ISSUER=https://accounts.google.com
STAFF_JWT_AUDIENCE=your-google-oauth-client-id.apps.googleusercontent.com
STAFF_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
STAFF_WORKSPACE_DOMAIN=example.com
STAFF_OPERATOR_EMAILS=operator@example.com
STAFF_SUPPORT_EMAILS=support@example.com

# Execution & Research Graph Limits
SLICE_SECONDS=240
MAX_SLICES=60
TENANT_CONCURRENCY=5
RUN_BUDGET_USD=5.0
ENV=dev

# Connectors & External Research Providers (Optional for live runs)
CONNECTORS=on
P_SEARCH_API_KEY=your-parallel-search-api-key
P_SCRAPE_API_KEY=your-firecrawl-api-key
P_SIGNALS_API_KEY=your-predictleads-api-key
P_SIGNALS_API_TOKEN=your-predictleads-token
P_PEOPLE_API_KEY=your-bitscale-api-key
P_ORG_API_KEY=your-sumble-api-key

# Object Storage (GCS or S3-compatible)
OBJECT_STORE_ENDPOINT=http://localhost:4443
OBJECT_STORE_BUCKET=account-intelligence-dev
OBJECT_STORE_ACCESS_KEY=local-dev-only
OBJECT_STORE_SECRET_KEY=local-dev-only
OBJECT_STORE_REGION=us-east-1

# LLM Providers (Anthropic Claude 3.5 Sonnet, Fable, Opus)
# In production, credentials can be populated from Google Cloud Secret Manager
ANTHROPIC_API_KEY=your-anthropic-api-key
