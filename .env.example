# Local-only placeholders. Replace only in an untracked .env file; never commit secrets.
DATABASE_URL=postgresql+asyncpg://app_rw:local-dev-only@localhost:5432/ai
MIGRATOR_DATABASE_URL=postgresql://postgres:dev@localhost:5432/ai
CHECKPOINT_DATABASE_URL=postgresql://app_rw:local-dev-only@localhost:5432/ai
APP_RW_PASSWORD=local-dev-only

JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
JWT_AUDIENCE=account-intelligence-local
JWT_ISSUER=https://identity.example.invalid/

# Separate Google Workspace staff plane. Match STAFF_JWT_AUDIENCE to the Google OAuth client ID.
# Enable the auth_time and amr ID-token claims; the API requires amr=mfa inside the step-up window.
STAFF_JWT_ISSUER=https://accounts.google.com
STAFF_JWT_AUDIENCE=replace-with-google-oauth-client-id
STAFF_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
STAFF_WORKSPACE_DOMAIN=example.com
STAFF_OPERATOR_EMAILS=operator@example.com
STAFF_SUPPORT_EMAILS=

SLICE_SECONDS=240
MAX_SLICES=60
TENANT_CONCURRENCY=5
RUN_BUDGET_USD=5.0
ENV=dev

# Enable provider connectors in the local dev API (cloud environments wire them automatically).
CONNECTORS=on

# Server-side provider API credentials. Keep real values only in the ignored local .env file.
# Parallel
P_SEARCH_API_KEY=
# Firecrawl
P_SCRAPE_API_KEY=
# PredictLeads requires both an API key and API token.
P_SIGNALS_API_KEY=
P_SIGNALS_API_TOKEN=
# BitScale
P_PEOPLE_API_KEY=
# Sumble
P_ORG_API_KEY=

# S3-compatible object storage for raw provider payloads (SeaweedFS locally, see compose.yml).
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=account-intelligence-dev
OBJECT_STORE_ACCESS_KEY=local-dev-only
OBJECT_STORE_SECRET_KEY=local-dev-only
OBJECT_STORE_REGION=us-east-1
