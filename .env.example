# Local-only placeholders. Replace only in an untracked .env file; never commit secrets.
DATABASE_URL=postgresql+asyncpg://app_rw:local-dev-only@localhost:5432/ai
MIGRATOR_DATABASE_URL=postgresql://postgres:dev@localhost:5432/ai
CHECKPOINT_DATABASE_URL=postgresql://app_rw:local-dev-only@localhost:5432/ai
APP_RW_PASSWORD=local-dev-only

JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
JWT_AUDIENCE=account-intelligence-local
JWT_ISSUER=https://identity.example.invalid/

SLICE_SECONDS=240
MAX_SLICES=60
TENANT_CONCURRENCY=5
RUN_BUDGET_USD=5.0
ENV=dev

# S3-compatible object storage for raw provider payloads (MinIO locally).
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=account-intelligence-dev
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_REGION=us-east-1
