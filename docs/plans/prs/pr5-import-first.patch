+def _deliverables_root(names: Iterable[str]) -> str | None:
+    """The fallback root (PR5, 2026-11-04): the parent of the shallowest ``deliverables/`` folder
+    that holds at least one file with a deliverable suffix; None when there is none."""
+    best: str | None = None
