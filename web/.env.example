# Next.js server-side settings. Copy to .env.local (ignored by git) for local development and
# fill in values there; never commit a value. In the cloud, Terraform sets these on the web
# service and injects the client secret from Secret Manager.
API_ORIGIN=http://127.0.0.1:8080

# Operator (6th staff) sign-in with Google. Each setting can instead be read from a file by
# setting NAME_FILE to its path (for example a mounted secret), so the value is never in the
# environment: OPERATOR_GOOGLE_CLIENT_ID_FILE, OPERATOR_GOOGLE_CLIENT_SECRET_FILE.
# Without all four, operator sign-in is switched off (the page says so).
OPERATOR_GOOGLE_CLIENT_ID=
OPERATOR_GOOGLE_CLIENT_SECRET=
OPERATOR_GOOGLE_REDIRECT_URI=http://localhost:3000/api/operator/callback
STAFF_WORKSPACE_DOMAIN=
