# Next.js server-side operator auth configuration. Copy to .env.local; do not commit secrets.
API_ORIGIN=http://127.0.0.1:8080
OPERATOR_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
OPERATOR_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
OPERATOR_GOOGLE_REDIRECT_URI=http://localhost:3000/api/operator/callback
STAFF_WORKSPACE_DOMAIN=example.com
