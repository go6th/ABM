{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-parity/types/**/*.ts",
    ".next-parity/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-parity",
    "components/ProviderKey.tsx",
    "components/ws/AccountAsk.tsx",
    "components/ws/AccountList.tsx",
    "components/ws/CitationChip.tsx",
    "components/ws/CitedText.tsx",
    "components/ws/Conversations.tsx",
    "components/ws/DeepDiveLinks.tsx",
    "components/ws/Downloads.tsx",
    "components/ws/EvidenceDrawer.tsx",
    "components/ws/evidence.ts",
    "components/ws/FileUploader.tsx",
    "components/ws/HomeAsk.tsx",
    "components/ws/InternalView.tsx",
    "components/ws/RefreshDialog.tsx",
    "components/ws/RunStatus.tsx",
    "components/ws/RunStopReport.tsx",
    "components/ws/SettingsFrame.tsx",
    "components/ws/SettingsNav.tsx",
    "components/ws/UsedPanel.tsx",
    "components/ws/WebOffer.tsx",
    "ui/ThemeToggle.tsx",
    "ui/theme.ts",
    "ui/theme-server.ts",
    "ui/Scene.tsx",
    "ui/Feedback.tsx",
    "ui/ConfirmButton.tsx",
    "ui/contrast.ts",
    "ui/Input.tsx",
    "ui/RunProgress.tsx",
    "ui/DataTable.tsx",
    "lib/research-files.ts",
    "lib/file-generator.ts",
    "lib/run-stop.ts",
    "lib/report.ts",
    "lib/provider-labels.ts",
    "lib/operator-render.ts",
    "lib/client.ts",
    "app/operator/(console)/SupportGrantLookup.tsx",
    "app/operator/(console)/OperatorStates.tsx",
    "app/operator/(console)/OperatorCrumb.tsx",
    "tests/unit/components.test.tsx",
    "tests/unit/research-files.test.tsx",
    "tests/unit/run-stop.test.tsx",
    "tests/unit/ws-components.test.tsx",
    "tests/unit/ui-tokens.test.ts",
    "tests/unit/ws-copy.test.ts",
    "tests/unit/documents.test.tsx",
    "e2e/parity/**",
    "e2e/review/**",
    "playwright.parity.config.ts",
    "playwright.review.config.ts",
    "screenshot_test.spec.ts"
  ]
}
