{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6th.example/schemas/account_bundle/1.0.0",
  "title": "AccountBundle",
  "description": "One research run's whole content for ONE account, whatever the account. The UI, the file renderers and the chat answer from this and from nothing else. Every number is computed by code (`computed`); the model writes only `prose`. Nothing in this schema is specific to any account: the prefix, legal name, domain, dates, lanes and entity labels are data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "sources", "jobs_read", "jobs_rows", "people_rows", "people_excluded", "stack_rows", "team_rows", "ranking", "computed", "prose"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["account_short", "account_legal", "domain", "run_date", "pull_date", "window", "window_display", "pursuing_client_display", "byline", "lanes", "entities"],
      "properties": {
        "account_short": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z0-9][A-Za-z0-9 .&'-]*$", "description": "File name prefix and the word the Entity column starts with for the account's own positions."},
        "account_legal": {"type": "string", "minLength": 1, "maxLength": 200},
        "domain": {"type": "string", "minLength": 3, "maxLength": 253},
        "careers_site": {"type": ["string", "null"], "description": "The careers host searched live (shown in the Sources and Evidence Part E paragraph)."},
        "run_date": {"type": "string", "description": "Display form, e.g. 20 October 2026 (phase 2 date)."},
        "pull_date": {"type": "string", "description": "Display form of the phase 1 pull date."},
        "pull_date_short": {"type": ["string", "null"], "description": "Short display form of the pull date used in headings and columns, e.g. 19 Oct 2026."},
        "window": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}}},
        "window_display": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}},
        "pursuing_client_display": {"type": "string", "description": "What every client facing file calls the pursuing client (normally the word Client)."},
        "pursuing_client_internal": {"type": ["string", "null"], "description": "The real pursuing client. Internal only: never rendered into a client file, the zip or a share. The confidentiality check fails on any file that contains it."},
        "pursuing_client_aliases": {"type": "array", "items": {"type": "string"}, "description": "Other spellings and the client's email domains; scrubbed like the name."},
        "byline": {"type": "string"},
        "lanes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "The lane platforms in the order the Jobs Summary, Part C and the Summary section 5 table print them."},
        "people_lanes": {"type": "array", "items": {"type": "string"}, "description": "The People List lane labels in the order the People Summary prints them."},
        "entities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "counted_as_account"], "properties": {"label": {"type": "string"}, "counted_as_account": {"type": "boolean", "description": "True for the account's own positions (the label starts with account_short); false for a divested or separately counted business."}, "note": {"type": "string"}, "phrase": {"type": "string", "description": "How the Summary section 5 base paragraph names this entity's removed postings after their count, e.g. Waters positions, or pre close postings of the divested business. Defaults to the label followed by the word positions."}, "patterns": {"type": "array", "items": {"type": "string"}, "description": "Case sensitive regular expressions on the posting title and description that tag a posting with this label (parity.rules.tag_entity, in list order). An entity without patterns is the default, the account itself."}, "before": {"type": "string", "format": "date", "description": "A dated rule: it applies only to postings first seen before this date (a business divested on that date)."}}}},
        "out_of_scope_platforms": {"type": "array", "items": {"type": "string"}},
        "live_capture_count": {"type": "integer", "minimum": 0},
        "feed_unique_links": {"type": "integer", "minimum": 0},
        "raw_board_counts": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "Raw live board match counts per lane keyword (Part E paragraph)."},
        "source_ids": {"type": "object", "additionalProperties": false, "properties": {"feed": {"type": "string"}, "detections": {"type": "string"}, "teams": {"type": "string"}, "news_feed": {"type": "string"}, "live_board": {"type": "string"}}, "description": "Source register IDs of the data pulls, printed in brackets after the headings that cite them (Summary section 5 base paragraph and Sources and Evidence Part H): feed is the structured postings feed, detections the technology detections, teams the platform teams, news_feed the news feed, live_board the live careers site search. A heading prints no bracket when its ID is absent."},
        "part_c_lanes": {"type": "array", "items": {"type": "string"}, "description": "Lane order of Sources and Evidence Part C when it differs from meta.lanes (the reference prints Part C in a different order from its jobs tables)."}
      }
    },
    "sources": {"type": "object", "propertyNames": {"pattern": "^S[0-9]+$"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["name", "url", "type", "date", "how", "supports"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "type": {"type": "string"}, "date": {"type": "string"}, "how": {"type": "string"}, "supports": {"type": "string"}}}},
    "jobs_read": {"type": "object", "propertyNames": {"pattern": "^J[0-9]+$"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["name", "url", "plats", "cls", "what", "status", "f", "ent"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "plats": {"type": "string", "description": "Comma and space separated lane platforms."}, "cls": {"type": "string", "enum": ["Build role", "Admin and owner role", "Working tool", "User role"]}, "what": {"type": "string"}, "status": {"type": "string", "enum": ["Open", "Closed"]}, "f": {"type": "string", "format": "date"}, "ent": {"type": "string"}}}},
    "jobs_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["title", "platforms", "cls", "status", "first_seen", "last_seen", "location", "seniority", "entity", "what", "platform_sentences", "description", "url"], "properties": {"requisition": {"type": ["string", "null"]}, "title": {"type": "string"}, "platforms": {"type": "array", "items": {"type": "string"}, "description": "In the dictionary's order; printed joined by comma and space."}, "cls": {"type": "string", "enum": ["Build role", "Admin and owner role", "Working tool", "User role"]}, "status": {"type": "string", "enum": ["Open", "Closed"]}, "first_seen": {"type": "string", "format": "date"}, "last_seen": {"type": "string", "format": "date"}, "location": {"type": "string"}, "seniority": {"type": ["string", "null"]}, "entity": {"type": "string"}, "what": {"type": "string"}, "platform_sentences": {"type": "string", "maxLength": 3000}, "description": {"type": "string", "maxLength": 32000}, "url": {"type": "string", "format": "uri"}}}},
    "people_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "title", "level", "senior", "lane", "priority", "found_by"], "properties": {"name": {"type": "string"}, "title": {"type": "string"}, "level": {"type": "integer", "minimum": 1, "maximum": 9, "description": "1 C-level, EVP and SVP; 2 VP; 3 Senior Director; 4 Director; 5 Associate Director; 6 Head; 7 Senior Manager; 8 Manager; 9 Lead, owner, specialist or developer."}, "senior": {"type": "boolean"}, "lane": {"type": "string"}, "priority": {"type": "string", "enum": ["A", "B", "C"]}, "former_si": {"type": "string"}, "found_by": {"type": "string"}, "profile_url": {"type": ["string", "null"], "format": "uri"}, "second_profile_url": {"type": ["string", "null"]}, "location": {"type": "string"}, "note": {"type": "string"}, "employer_label": {"type": "string"}}}},
    "people_excluded": {"type": "object", "additionalProperties": false, "required": ["domain", "security", "unresolved", "below_rule_no_stack"], "properties": {"domain": {"type": "array", "items": {"type": "string"}}, "security": {"type": "array", "items": {"type": "string"}, "description": "Name (title cut to 50 characters)."}, "unresolved": {"type": "array", "items": {"type": "string"}}, "below_rule_no_stack": {"type": "array", "items": {"type": "string"}}}},
    "overrides": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "priority": {"type": "string", "enum": ["A", "B", "C"]}, "lane": {"type": "string"}, "note": {"type": "string"}}}, "description": "Analyst corrections applied after the rules (data, never code)."},
    "stack_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["business_function", "category", "technology", "postings", "lane"], "properties": {"business_function": {"type": "string"}, "category": {"type": "string"}, "technology": {"type": "string"}, "postings": {"type": ["integer", "null"]}, "lane": {"type": "string"}}}},
    "team_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["team", "lane_technologies", "postings", "first_activity", "last_activity", "technologies", "locations", "job_functions"], "properties": {"team": {"type": "string"}, "lane_technologies": {"type": "string"}, "postings": {"type": ["integer", "null"]}, "first_activity": {"type": "string"}, "last_activity": {"type": "string"}, "technologies": {"type": "string"}, "locations": {"type": "string"}, "job_functions": {"type": "string"}}}},
    "ranking": {"type": "object", "additionalProperties": false, "required": ["base", "rows", "seen_once"], "properties": {"base": {"type": "integer", "minimum": 0}, "rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["platform", "category", "lane", "count", "open", "last_seen", "in_stack", "checked"], "properties": {"platform": {"type": "string"}, "category": {"type": "string"}, "lane": {"type": "string"}, "count": {"type": "integer"}, "open": {"type": "integer"}, "last_seen": {"type": "string"}, "in_stack": {"type": "string", "enum": ["Yes", "No", "Not pulled"]}, "checked": {"type": "string", "enum": ["Yes", "No"]}}}}, "seen_once": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["platform", "category", "lane"], "properties": {"platform": {"type": "string"}, "category": {"type": "string"}, "lane": {"type": "string"}}}}}},
    "computed": {
      "type": "object", "additionalProperties": false,
      "required": ["jobs_counts", "ent_counts", "lane_rows_account", "lane_rows_all", "people_total", "senior", "prio", "excluded", "tracker_tally"],
      "properties": {
        "jobs_counts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["total", "open", "build", "admin", "tool", "user"], "properties": {"total": {"type": "integer"}, "open": {"type": "integer"}, "build": {"type": "integer"}, "admin": {"type": "integer"}, "tool": {"type": "integer"}, "user": {"type": "integer"}}}},
        "ent_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "lane_rows_account": {"type": "integer"},
        "lane_rows_all": {"type": "integer"},
        "people_total": {"type": "integer"},
        "senior": {"type": "integer"},
        "prio": {"type": "object", "additionalProperties": false, "properties": {"A": {"type": "integer"}, "B": {"type": "integer"}, "C": {"type": "integer"}}, "description": "Priority counts among senior people."},
        "excluded": {"type": "object", "additionalProperties": {"type": "integer"}},
        "pf": {"type": "object", "description": "Profile findings statistics (senior_with_profiles, tenure_median, ...)."},
        "tracker_tally": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "prose": {
      "type": "object", "additionalProperties": false,
      "required": ["glossary", "narrative", "news", "news_not_covered", "baseline", "signals", "platform", "hiring_interpretation", "people_text", "key_people", "profile_findings", "status_changes", "people_interpretation", "hypotheses", "cautions", "first_call", "waiting", "tracker_p1", "tracker_p2", "evidence", "workbook_notes"],
      "properties": {
        "glossary": {"type": "string"},
        "narrative": {"type": "object", "additionalProperties": false, "required": ["picture", "stands_out", "lanes", "wrong", "sharpen"], "properties": {"picture": {"type": "array", "items": {"type": "string"}}, "stands_out": {"type": "array", "items": {"type": "string"}}, "lanes": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}, "wrong": {"type": "array", "items": {"type": "string"}}, "sharpen": {"type": "array", "items": {"type": "string"}}}},
        "news": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 5, "maxItems": 5}},
        "news_not_covered": {"type": "string"},
        "baseline": {"type": "array", "items": {"type": "string"}},
        "signals": {"type": "object", "additionalProperties": false, "required": ["Tier 1", "Tier 2", "Tier 3", "Context and history"], "properties": {"Tier 1": {"$ref": "#/$defs/rows5"}, "Tier 2": {"$ref": "#/$defs/rows5"}, "Tier 3": {"$ref": "#/$defs/rows5"}, "Context and history": {"$ref": "#/$defs/rows5"}}},
        "platform": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4}},
        "hiring_interpretation": {"type": "string"},
        "hiring_base": {"type": "string", "description": "The whole Summary section 5 base paragraph (Base: N postings in the feed after removing ...; M of them name at least one lane platform (feed source). Build role means ...). When absent the renderer composes it from computed.ent_counts, meta.entities, computed.lane_rows_account and meta.source_ids.feed."},
        "people_text": {"type": "object", "additionalProperties": false, "required": ["built", "profiles", "exclusions"], "properties": {"built": {"type": "string"}, "profiles": {"type": "string"}, "exclusions": {"type": "string"}}},
        "key_people": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 6, "maxItems": 6, "description": "Name, title, lane, priority, profile url or empty, note."}},
        "profile_findings": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4}},
        "status_changes": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4}},
        "people_interpretation": {"type": "array", "items": {"type": "string"}},
        "hypotheses": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
        "cautions": {"type": "array", "items": {"type": "string"}},
        "first_call": {"type": "array", "items": {"type": "string"}},
        "waiting": {"type": "array", "items": {"type": "string"}},
        "tracker_p1": {"$ref": "#/$defs/rows6"},
        "tracker_p2": {"$ref": "#/$defs/rows6"},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["extracts", "live_rows", "live_lane_count", "leads", "detections", "news_events"], "properties": {"extracts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "url", "quotes"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"}, "quotes": {"type": "array", "items": {"type": "string"}}}}}, "live_rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 6, "maxItems": 6, "description": "Posting title, url, platforms, entity, read in full, class."}}, "live_lane_count": {"type": "integer"}, "leads": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4}}, "detections": {"type": "array", "items": {"type": "array", "items": {"type": ["string", "integer", "number"]}, "minItems": 6, "maxItems": 6}}, "news_events": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4}}, "news_events_heading": {"type": "string"}, "board_paragraph": {"type": "string"}, "part_c_closing": {"type": "string"}, "part_b_intro": {"type": "string"}, "part_g": {"type": "string"}, "detections_note": {"type": "string"}, "teams_note": {"type": "string"}}},
        "workbook_notes": {"type": "object", "additionalProperties": false, "required": ["people", "jobs", "stack"], "properties": {"people": {"type": "array", "items": {"type": "string"}, "description": "Summary sheet notes except the security exclusion line, which the renderer builds from people_excluded.security."}, "jobs": {"type": "array", "items": {"type": "string"}}, "stack": {"type": "object", "additionalProperties": false, "required": ["confirmed_title", "confirmed_note", "teams_title", "teams_note", "ranking_notes"], "properties": {"confirmed_title": {"type": "string"}, "confirmed_note": {"type": "string"}, "teams_title": {"type": "string"}, "teams_note": {"type": "string"}, "ranking_notes": {"type": "array", "items": {"type": "string"}}}}, "people_security_line_template": {"type": "string", "description": "Template of the People Summary security exclusion line, with {count} (unique names) and {names} (the people_excluded.security entries joined by semicolons). Default: the reference wording."}, "people_security_line_at": {"type": "integer", "minimum": 0, "description": "Index among the People Summary notes at which the renderer inserts the security line (default 2)."}, "jobs_other_entities_label": {"type": "string", "description": "Label of the Jobs Summary row that counts rows which are not the account's positions (default: Rows that are not {prefix} positions)."}}},
        "lane_highlights": {"type": ["object", "null"], "additionalProperties": false, "required": ["subtitle", "sections"], "properties": {"subtitle": {"type": "string"}, "sections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["heading", "bullets"], "properties": {"heading": {"type": "string"}, "bullets": {"type": "array", "items": {"type": "string"}}}}}}},
        "internal_only": {"type": ["object", "null"], "additionalProperties": false, "required": ["title_suffix", "dates", "items", "why", "instead"], "properties": {"title_suffix": {"type": "string"}, "dates": {"type": "string"}, "items": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}, "why": {"type": "array", "items": {"type": "string"}}, "instead": {"type": "string"}}, "description": "The pursuing client's own records (the reference named this file after a person). Never in the zip, never in a share."}
      }
    }
  },
  "$defs": {
    "rows5": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 5, "maxItems": 5}},
    "rows6": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 6, "maxItems": 6}}
  }
}
