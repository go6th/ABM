+            }
+            for row in rows
+        ]
+    }
+
+
+def _view_sheet(role: str, sheet_names: list[str]) -> str | None:
+    """Choose the deliverable sheet for a named view using generic sheet names."""
+    needles = {
+        "people": ("people",),
+        "jobs": ("jobs", "posting"),
+        "ranking": ("ranking", "platform"),
+        "stack": ("confirmed", "stack"),
+        "teams": ("teams", "team"),
+    }
+    wanted = needles.get(role)
+    if wanted is None:
+        return None
+    folded = [(name, name.casefold()) for name in sheet_names]
+    for token in wanted:
+        for name, candidate in folded:
+            if token in candidate:
+                return name
+    return None
+
+
+@router.get(
+    "/{domain}/workspace-imports/{import_id}/views/{view}",
+    response_model=WorkspaceImportViewReply,
+)
+async def workspace_import_view(
+    domain: str,
+    import_id: UUID,
+    view: Literal["summary", "news", "evidence", "people", "jobs", "ranking", "stack", "teams"],
+    request: Request,
+    sheet: str | None = Query(default=None, max_length=128),
+    offset: int = Query(default=0, ge=0),
+    limit: int = Query(default=100, ge=1, le=500),
+    ident: Identity = Depends(authorize),
+) -> dict[str, Any]:
+    """Read an owner-private parsed deliverable, with bounded workbook paging."""
+    async with tenant_txn(ident.tenant_id) as session:
+        account_id = await account_id_of(session, domain)
+        version = await WIR.get_version(session, account_id, import_id)
+    if version is None:
+        raise HTTPException(404, "not found")
+    role: str = "summary" if view == "news" else view
+    if role not in {"evidence", "summary", "people", "jobs"}:
+        role = "tech"
+    key = account_path(
+        ident.tenant_id, account_id, "workspaces", str(import_id), "views", f"{role}.json"
+    )
+    try:
+        require_owned(ident.tenant_id, key)
+        encoded = await request.app.state.container.payloads.get(key)
+        parsed = await run_in_threadpool(json.loads, bytes(encoded))
+    except Exception:  # noqa: BLE001 - treat missing or unreadable download objects as unavailable
+        return {
+            "id": import_id,
+            "version": version,
+            "view": view,
+            "available": False,
+            "reason": "This deliverable view is unavailable or exceeded its parsing limits.",
+            "source_file": None,
+            "kind": None,
+            "blocks": [],
+            "sheet_names": [],
+            "selected_sheet": None,
+            "header_candidates": [],
+            "total_rows": 0,
+            "offset": offset,
+            "limit": limit,
+            "rows": [],
+        }
+    if parsed.get("kind") == "document":
+        blocks = parsed.get("blocks", [])
+        if view == "news":
+            selected_blocks: list[dict[str, Any]] = []
+            active = False
+            for block in blocks:
+                style = str(block.get("style", "")).casefold()
+                if block.get("kind") == "paragraph" and "heading" in style:
+                    active = "news" in str(block.get("text", "")).casefold()
+                if active:
+                    selected_blocks.append(block)
+            if selected_blocks:
+                blocks = selected_blocks
+            else:
+                return {
+                    "id": import_id,
+                    "version": version,
+                    "view": view,
+                    "available": False,
+                    "reason": "No clearly labeled news section was found in the summary document.",
+                    "source_file": parsed.get("source_file"),
+                    "kind": "document",
+                    "blocks": [],
+                    "sheet_names": [],
+                    "selected_sheet": None,
+                    "header_candidates": [],
+                    "total_rows": 0,
+                    "offset": offset,
+                    "limit": limit,
+                    "rows": [],
+                }
+        return {
+            "id": import_id,
+            "version": version,
+            "view": view,
+            "available": True,
+            "reason": None,
+            "source_file": parsed.get("source_file"),
+            "kind": "document",
+            "blocks": blocks,
+            "sheet_names": [],
+            "selected_sheet": None,
+            "header_candidates": [],
+            "total_rows": 0,
+            "offset": offset,
+            "limit": limit,
+            "rows": [],
+        }
+    sheets: list[dict[str, Any]] = parsed.get("sheets", [])
+    names = [str(item.get("name", "")) for item in sheets]
+    selected_name = sheet if sheet in names else _view_sheet(view, names)
+    selected_sheet_record: dict[str, Any] | None = None
+    for item in sheets:
+        if item.get("name") == selected_name:
+            selected_sheet_record = item
+            break
+    if selected_sheet_record is None:
+        return {
+            "id": import_id,
+            "version": version,
+            "view": view,
+            "available": False,
+            "reason": "No matching worksheet was found in this deliverable.",
+            "source_file": parsed.get("source_file"),
+            "kind": "workbook",
+            "blocks": [],
+            "sheet_names": names,
+            "selected_sheet": None,
+            "header_candidates": [],
+            "total_rows": 0,
+            "offset": offset,
+            "limit": limit,
+            "rows": [],
+        }
+    all_rows: list[list[Any]] = selected_sheet_record.get("rows", [])
+    header_candidates = (
+        [str(value) for value in all_rows[0] if value is not None] if all_rows else []
+    )
+    return {
+        "id": import_id,
+        "version": version,
+        "view": view,
+        "available": True,
+        "reason": None,
+        "source_file": parsed.get("source_file"),
+        "kind": "workbook",
+        "blocks": [],
+        "sheet_names": names,
+        "selected_sheet": selected_name,
+        "header_candidates": header_candidates,
+        "total_rows": len(all_rows),
+        "offset": offset,
+        "limit": limit,
+        "rows": all_rows[offset : offset + limit],
+    }
+
+
+@router.get("/{domain}/workspace-imports/{import_id}/downloads")
+async def download_workspace_import(
+    domain: str,
+    import_id: UUID,
+    request: Request,
+    ident: Identity = Depends(authorize),
+) -> Response:
+    """Download only recognized client deliverables; source/internal files stay private."""
+    async with tenant_txn(ident.tenant_id) as session:
+        account_id = await account_id_of(session, domain)
+        if not await WIR.exists(session, account_id, import_id):
+            raise HTTPException(404, "not found")
+        await audit_action(
+            session,
+            request,
+            audit_class="export",
+            action="workspace_import_download",
+            resource_type="account_workspace_import",
+            resource_id=import_id,
+        )
+    key = account_path(
+        ident.tenant_id,
+        account_id,
+        "workspaces",
+        str(import_id),
+        "downloads",
+        "client-deliverables.zip",
+    )
+    try:
+        require_owned(ident.tenant_id, key)
+        body = bytes(await request.app.state.container.payloads.get(key))
+    except Exception:  # noqa: BLE001 - missing or unreadable private downloads are indistinguishable
+        raise HTTPException(404, "client deliverables are unavailable") from None
+    return Response(
+        content=body,
+        media_type="application/zip",
+        headers={
+            "Content-Disposition": 'attachment; filename="workspace-deliverables.zip"',
+            "Cache-Control": "no-store",
+        },
+    )
+
