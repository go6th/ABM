+async def _bounded_body(request: Request) -> bytes:
+    """Read an upload without allowing the HTTP body to exceed the ZIP boundary."""
+    content_length = request.headers.get("content-length")
+    if content_length is not None:
+        try:
+            if int(content_length) > MAX_ARCHIVE_BYTES:
+                raise HTTPException(413, "workspace archive exceeds upload limit")
+        except ValueError:
+            raise HTTPException(400, "invalid content length") from None
+    chunks: list[bytes] = []
+    size = 0
+    async for chunk in request.stream():
+        size += len(chunk)
+        if size > MAX_ARCHIVE_BYTES:
+            raise HTTPException(413, "workspace archive exceeds upload limit")
+        chunks.append(chunk)
+    if not size:
+        raise HTTPException(422, "workspace archive is empty")
+    return b"".join(chunks)
