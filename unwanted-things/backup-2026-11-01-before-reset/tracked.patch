     return status
 
 
+# how long a run's end waits for its client tables to be built; past it the first page view builds
+# them (single-flight, ``views.materialize``)
+TABLES_CEILING_S = 900.0
+
+
+async def _materialise_tables(deps: RunDeps) -> None:
+    """Build the finished run's client tables now, so the account page's first view is a read and
+    not the whole build (BD 2026-11-01: the first view took 33 minutes and the page timed out).
+    Best effort: a failure or a timeout is logged and never changes the run's outcome."""
+    builder = deps.builder
+    reader = getattr(builder, "reader", None)
+    cfg = getattr(builder, "cfg", None)
+    grading = getattr(builder, "grading", None)
+    if reader is None or cfg is None or grading is None:
+        return
+    from views.materialize import materialize
+
+    started = time.perf_counter()
+    try:
+        async with asyncio.timeout(TABLES_CEILING_S):
+            found = await materialize(
+                deps.txn, reader, cfg, grading, deps.tenant_id, deps.run_id, deps.clock.now()
+            )
+    except Exception as error:  # noqa: BLE001 - the first page view builds them instead
+        _log.warning("run.tables_failed", extra={"error_class": type(error).__name__})
+        return
+    _log.info(
+        "run.tables_built",
+        extra={"status": found.status, "ms": round(1000 * (time.perf_counter() - started))},
+    )
+
+
