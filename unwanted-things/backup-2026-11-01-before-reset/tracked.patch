+
+async def _backfill_tables(app: FastAPI) -> int:
+    """Build the client tables of one finished run that has none, every account of every client:
+    the newest completed or partial run of each account, one per pass. A run builds its tables
+    when it ends (``workflow.runner``); this covers the runs that ended before that existed or
+    whose build failed, so no account's first page view is the whole build (BD 2026-11-01: 33
+    minutes, a page that timed out). Returns how many runs were built."""
+    import asyncio
+    import time
+    from datetime import UTC, datetime
+    from uuid import UUID
+
+    from sqlalchemy import text
+
+    from account_intelligence.db.session import tenant_txn, untenanted_session
+    from views.materialize import materialize
+
+    builder = getattr(app.state.container, "builder", None)
+    reader = getattr(builder, "reader", None)
+    cfg = getattr(builder, "cfg", None)
+    grading = getattr(builder, "grading", None)
+    if reader is None or cfg is None or grading is None:
+        return 0
+    async with untenanted_session() as plain:
+        tenants = [
+            UUID(str(r.tenant_id))
+            for r in await plain.execute(text("SELECT tenant_id FROM operator_tenant_overview()"))
+        ]
+    now_s = time.monotonic()
+    # LOOP(tables backfill clients): cap=every client once per pass; exit=first run built
+    for tenant in tenants:
+        async with tenant_txn(tenant, system=True) as s:
+            runs = [
+                r.id
+                for r in await s.execute(
+                    text(
+                        "SELECT l.id FROM (SELECT DISTINCT ON (r.account_id) r.id, r.created_at"
+                        " FROM account_runs r WHERE r.status IN ('COMPLETED', 'PARTIAL')"
+                        " ORDER BY r.account_id, r.created_at DESC) l"
+                        " WHERE NOT EXISTS (SELECT 1 FROM view_materializations m"
+                        "  WHERE m.run_id = l.id) ORDER BY l.created_at DESC LIMIT 5"
+                    )
+                )
+            ]
+        # LOOP(tables backfill runs): cap=5 candidates per client; exit=first run built
+        for run in runs:
+            if _tables_failed.get(run, 0.0) > now_s:
+                continue
+            started = time.perf_counter()
+            try:
+                async with asyncio.timeout(_TABLES_CEILING_S):
+                    found = await materialize(
+                        tenant_txn, reader, cfg, grading, tenant, run, datetime.now(UTC)
+                    )
+            except Exception as error:  # noqa: BLE001 - a run that cannot be built waits an hour
+                _tables_failed[run] = now_s + _TABLES_RETRY_S
+                _logger.warning(
+                    "tables.backfill_failed", extra={"error_class": type(error).__name__}
+                )
+                continue
+            _logger.info(
+                "tables.backfilled",
+                extra={
+                    "status": found.status,
+                    "ms": round(1000 * (time.perf_counter() - started)),
+                },
+            )
+            return 1
+    return 0
 
 
