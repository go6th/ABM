         await mat.materialize(tenant_txn, build.reader, CFG, GRADING, w.tenant, other.run, now)
 
 
+class _CountingReader:
+    """A content reader that counts the snapshots it is asked for."""
+
+    def __init__(self, inner: Any) -> None:
+        self.inner, self.reads = inner, 0
+
+    async def read(self, tenant_id: str, run_id: str) -> Any:
+        self.reads += 1
+        await asyncio.sleep(0.2)  # long enough for every concurrent caller to arrive
+        return await self.inner.read(tenant_id, run_id)
+
+
+def _forget_tables(run: Any) -> None:
+    with psycopg.connect(_admin(), autocommit=True) as c:
+        c.execute("SET session_replication_role = replica")
+        c.execute("DELETE FROM view_rows WHERE run_id = %s", (run,))
+        c.execute("DELETE FROM view_materializations WHERE run_id = %s", (run,))
+
+
+def _materialised(run: Any) -> bool:
+    with psycopg.connect(_admin()) as c:
+        return bool(
+            c.execute(
+                "SELECT count(*) FROM view_materializations WHERE run_id = %s", (run,)
+            ).fetchone()[0]
+        )
+
+
+@pytest.mark.requires_postgres
+@pytest.mark.asyncio
+async def test_concurrent_first_views_read_the_snapshot_once(seeded: Any) -> None:
+    """Page loads that arrive while the first build is reading wait for it; they do not each read
+    the whole run (BD 2026-11-01: eight loads kept the database at full CPU for an hour)."""
+    from datetime import UTC, datetime
+
+    from account_intelligence.db.session import tenant_txn
+    from views import materialize as mat
+
+    w, _, build = seeded
+    _forget_tables(w.run)
+    reader = _CountingReader(build.reader)
+    now = datetime.now(UTC)
+    results = await asyncio.gather(
+        *(mat.materialize(tenant_txn, reader, CFG, GRADING, w.tenant, w.run, now) for _ in range(4))
+    )
+    assert reader.reads == 1
+    assert len({r.rows_hash for r in results}) == 1 and results[0].status == "ready"
+
+
+@pytest.mark.requires_postgres
+@pytest.mark.asyncio
+async def test_a_finished_run_builds_its_tables_at_the_end_and_the_sweeper_backfills(
+    seeded: Any,
+) -> None:
+    """Any account's finished run gets its tables before anyone opens the page: at the run's end
+    (``workflow.runner``), and for a run that ended without them, in the next sweeper pass."""
+    from datetime import UTC, datetime
+    from types import SimpleNamespace
+
+    from account_intelligence.api import main as api_main
+    from account_intelligence.db.session import tenant_txn
+    from account_intelligence.workflow.runner import _materialise_tables
+
+    w, _, build = seeded
+    _forget_tables(w.run)
+    deps = SimpleNamespace(
+        builder=build,
+        txn=tenant_txn,
+        tenant_id=w.tenant,
+        run_id=w.run,
+        clock=SimpleNamespace(now=lambda: datetime.now(UTC)),
+    )
+    await _materialise_tables(deps)  # type: ignore[arg-type]
+    assert _materialised(w.run)
+    # a builder without a reader (a test or a half-wired worker) builds nothing and does not fail
+    await _materialise_tables(SimpleNamespace(builder=None))  # type: ignore[arg-type]
+
+    _forget_tables(w.run)
+    app = SimpleNamespace(state=SimpleNamespace(container=SimpleNamespace(builder=build)))
+    api_main._tables_failed.clear()
+    built = 0
+    while not _materialised(w.run) and built < 20:  # other test worlds may be ahead of this one
+        built += await api_main._backfill_tables(app)  # type: ignore[arg-type]
+        if not built:
+            break
+    assert _materialised(w.run)
+
+
