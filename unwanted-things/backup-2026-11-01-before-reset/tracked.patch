+
+
+@router.get("/{domain}/workspace-imports", response_model=WorkspaceImportListReply)
+async def list_workspace_imports(
+    domain: str,
+    ident: Identity = Depends(authorize),
+) -> dict[str, Any]:
+    """Return tenant-visible metadata and validation results for an account's imports."""
+    async with tenant_txn(ident.tenant_id) as session:
+        account_id = await account_id_of(session, domain)
