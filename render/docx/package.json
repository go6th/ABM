{
  "name": "render-docx",
  "version": "1.0.0",
  "private": true,
  "description": "Word file renderer of the output parity system: the Account Summary, Sources and Evidence, Lane Highlights and internal-only files from one AccountBundle.",
  "type": "module",
  "bin": {
    "render-docx": "dist/cli.js"
  },
  "scripts": {
    "gen": "tsx scripts/gen_bundle_zod.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "docx": "9.13.0",
    "jszip": "3.10.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "fast-xml-parser": "^5.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
