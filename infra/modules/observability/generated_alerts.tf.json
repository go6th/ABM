{
 "resource": {
  "google_monitoring_alert_policy": {
   "alert_delivery_failed": {
    "combiner": "OR",
    "conditions": [
     {
      "condition_prometheus_query_language": {
       "duration": "0s",
       "evaluation_interval": "60s",
       "query": "sum(increase(workload_googleapis_com:alert_deliveries_total{outcome=\"failed\"}[3600s])) > 0"
      },
      "display_name": "alert_delivery_failed"
     }
    ],
    "count": "${var.workload_alerts_enabled ? 1 : 0}",
    "display_name": "alert_delivery_failed",
    "documentation": {
     "content": "Runbook: docs/runbooks/slack-outage.md. Owner: alerts.",
     "mime_type": "text/markdown"
    },
    "notification_channels": "${var.ticket_channels}",
    "project": "${var.project_id}",
    "user_labels": {
     "owner": "alerts",
     "severity": "ticket"
    }
   },
   "alert_flood": {
    "combiner": "OR",
    "conditions": [
     {
      "condition_prometheus_query_language": {
       "duration": "0s",
       "evaluation_interval": "60s",
       "query": "sum(increase(workload_googleapis_com:alert_deliveries_total{outcome=\"sent\"}[3600s])) > 200"
      },
      "display_name": "alert_flood"
     }
    ],
    "count": "${var.workload_alerts_enabled ? 1 : 0}",
    "display_name": "alert_flood",
    "documentation": {
     "content": "Runbook: docs/runbooks/alert-flood.md. Owner: alerts.",
     "mime_type": "text/markdown"
    },
    "notification_channels": "${var.ticket_channels}",
