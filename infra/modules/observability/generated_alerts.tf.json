{
 "resource": {
  "google_monitoring_alert_policy": {
   "api_availability_fast_burn": {
    "combiner": "OR",
    "conditions": [
     {
      "condition_threshold": {
       "comparison": "COMPARISON_GT",
       "duration": "0s",
       "filter": "metric.type=\"workload.googleapis.com/api_requests_total\"",
       "threshold_value": 14.4
      },
      "display_name": "api_availability_fast_burn"
     }
    ],
    "display_name": "api_availability_fast_burn",
    "documentation": {
     "content": "Runbook: docs/runbooks/api-availability-burn.md. Owner: oncall.",
     "mime_type": "text/markdown"
    },
    "notification_channels": "${var.page_channels}",
    "project": "${var.project_id}",
    "user_labels": {
     "owner": "oncall",
     "severity": "page"
    }
   },
   "api_availability_slow_burn": {
    "combiner": "OR",
    "conditions": [
     {
      "condition_threshold": {
