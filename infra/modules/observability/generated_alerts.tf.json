   "api_availability_fast_burn": {
    "combiner": "OR",
    "conditions": [
     {
      "condition_prometheus_query_language": {
       "duration": "0s",
       "evaluation_interval": "60s",
       "query": "(sum(rate(workload_googleapis_com:api_requests_total{code_class=~\"5xx|timeout\"}[1h])) / sum(rate(workload_googleapis_com:api_requests_total[1h]))) > 0.0144 and (sum(rate(workload_googleapis_com:api_requests_total{code_class=~\"5xx|timeout\"}[5m])) / sum(rate(workload_googleapis_com:api_requests_total[5m]))) > 0.0144 and sum(increase(workload_googleapis_com:api_requests_total[1h])) >= 100"
      },
      "display_name": "api_availability_fast_burn"
     }
    ],
    "count": "${var.workload_alerts_enabled ? 1 : 0}",
    "display_name": "api_availability_fast_burn",
    "documentation": {
     "content": "Runbook: docs/runbooks/api-availability-burn.md. Owner: oncall.",
     "mime_type": "text/markdown"
    },
    "notification_channels": "${var.page_channels}",
    "project": "${var.project_id}",
    "user_labels": {
     "owner": "oncall",
     "severity": "page"
    }
   },
   "api_availability_slow_burn": {
    "combiner": "OR",
    "conditions": [
     {
      "condition_prometheus_query_language": {
       "duration": "0s",
       "evaluation_interval": "60s",
       "query": "(sum(rate(workload_googleapis_com:api_requests_total{code_class=~\"5xx|timeout\"}[6h])) / sum(rate(workload_googleapis_com:api_requests_total[6h]))) > 0.006 and (sum(rate(workload_googleapis_com:api_requests_total{code_class=~\"5xx|timeout\"}[30m])) / sum(rate(workload_googleapis_com:api_requests_total[30m]))) > 0.006 and sum(increase(workload_googleapis_com:api_requests_total[6h])) >= 100"
      },
      "display_name": "api_availability_slow_burn"
     }
    ],
    "count": "${var.workload_alerts_enabled ? 1 : 0}",
    "display_name": "api_availability_slow_burn",
